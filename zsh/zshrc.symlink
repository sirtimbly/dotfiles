#!/usr/bin/env zsh
# The shebang is inert (this file is sourced, never executed). It exists so
# editors can detect the language: the ".symlink" extension matches no known
# file-type, so Helix/tree-sitter fall back to shebang sniffing.

# ------------- startup profiling -------------
# Run `zsh-profile` (or `ZSH_PROFILE=1 zsh -i -c exit`) for per-section timings
# plus a zprof function report. `zsh-bench` measures total startup time.
if [[ -n $ZSH_PROFILE ]]; then
  zmodload zsh/zprof zsh/datetime
  typeset -gF _zp_start=$EPOCHREALTIME _zp_last=$EPOCHREALTIME
  _zp() {
    local now=$EPOCHREALTIME
    printf '%7.1fms %7.1fms  %s\n' $(( (now - _zp_last) * 1000 )) \
      $(( (now - _zp_start) * 1000 )) "$1" >&2
    _zp_last=$EPOCHREALTIME
  }
  print -u2 '   step   total  section'
else
  _zp() { : }
fi

zsh-profile() { ZSH_PROFILE=1 zsh -i -c exit }
zsh-bench() {
  local i
  for i in {1..${1:-10}}; do /usr/bin/time zsh -i -c exit; done 2>&1 | grep real
}

# `eval "$(tool init zsh)"` forks the tool on every startup. Cache the output
# and only regenerate it when the tool's binary is newer than the cache.
# Run `zsh-clear-cache` after changing a tool's init flags.
_ZSH_EVAL_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/zsh-eval"
_cached_eval() {
  local name=$1; shift
  # Not ${commands[$1]}: after any PATH change that forces a full rehash of
  # every PATH dir (~15ms); whence looks up just this one command.
  local bin=$(whence -p $1)
  [[ -n $bin ]] || return 0
  local cache="$_ZSH_EVAL_CACHE/$name.zsh"
  if [[ ! -s $cache || $bin -nt $cache ]]; then
    mkdir -p "$_ZSH_EVAL_CACHE"
    "$@" >| "$cache"
  fi
  source "$cache"
  _zp "$name"
}
zsh-clear-cache() { rm -rf "$_ZSH_EVAL_CACHE" }

# Trust the ZScaler root CA instead of disabling TLS entirely.
# ~/.zscaler-root-ca.pem was extracted from the system keychain:
#   security find-certificate -a -c "Zscaler Root CA" -p /Library/Keychains/System.keychain > ~/.zscaler-root-ca.pem
export NODE_EXTRA_CA_CERTS="$HOME/.zscaler-root-ca.pem"

# Quick alias to temporarily bypass TLS (use with caution — e.g. behind a firewall)
alias tls-off='export NODE_TLS_REJECT_UNAUTHORIZED=0'
alias tls-on='unset NODE_TLS_REJECT_UNAUTHORIZED'


# Keep $path free of duplicates (first occurrence wins).
typeset -U path PATH

# ------------- PATH -------------
# The whole PATH is defined here, in priority order. Entries for missing dirs
# are dropped by the (N) glob qualifier, and the system tail is rebuilt from
# /etc/paths (+ paths.d) so stale entries inherited from a parent process
# (old usernames, removed Homebrew pythons) don't survive.
#
# mise runs in shims mode: one PATH entry instead of one per tool, and no
# `mise hook-env` on startup or before every prompt (~50ms each). Trade-off:
# no per-directory [env]/venv activation (only developer/luk uses
# python.uv_venv_auto). After `go install` or `npm i -g`, run `mise reshim`.
# ~/.local/bin and ~/.bun/bin stay ahead of the shims so their uv/hf/bun win.
export PNPM_HOME="$HOME/Library/pnpm"
export BUN_INSTALL="$HOME/.bun"
export GOPATH="$HOME/go"
export HOMEBREW_PREFIX=/opt/homebrew
export HOMEBREW_CELLAR=$HOMEBREW_PREFIX/Cellar
export HOMEBREW_REPOSITORY=$HOMEBREW_PREFIX
export INFOPATH="$HOMEBREW_PREFIX/share/info:${INFOPATH:-}"
_sys_path=(${(f)"$(</etc/paths)"})
for _f in /etc/paths.d/*(N); do _sys_path+=(${(f)"$(<$_f)"}); done
path=(
  $HOME/.opencode/bin(N)
  $BUN_INSTALL/bin(N)
  $HOME/.local/bin(N)              # pipx, uv, dstask, himalaya
  $HOME/.local/share/mise/shims(N)
  ./bin                            # per-project scripts (relative on purpose)
  $HOME/.dotfiles/bin(N)
  $HOMEBREW_PREFIX/bin(N)
  $HOMEBREW_PREFIX/sbin(N)
  $_sys_path
  $HOME/.cargo/bin(N)
  $GOPATH/bin(N)
  # APPEND, never prepend: if pnpm ever installs itself globally
  # (`pnpm self-update`), a prepended entry shadows the mise-managed pnpm and
  # you silently build lockfiles with the wrong pnpm major.
  $PNPM_HOME/bin(N)
  $HOME/.lmstudio/bin(N)
  /Applications/Ghostty.app/Contents/MacOS(N)
)
fpath=($HOMEBREW_PREFIX/share/zsh/site-functions $fpath)
unset _sys_path _f
_zp path

_cached_eval starship starship init zsh
_cached_eval atuin atuin init zsh
_cached_eval zoxide zoxide init --cmd=cd zsh

export DOTFILES="$HOME/.dotfiles"
export PROJECTS="$HOME/Projects"
export XDG_CONFIG_HOME="$HOME/.config"
export EDITOR="hx"
export VISUAL="hx"
export NOTES_DIR="$PROJECTS/notes"
export GODSPEED_SYNC_DIR="$NOTES_DIR/godspeed"
export HIMALAYA_CONFIG="$XDG_CONFIG_HOME/himalaya/config.toml"
export NVIM_LISTEN_ADDRESS=/tmp/nvim-server   # used by the `email` alias
export BAT_THEME="Monokai Extended"
export FLAVOR="mocha"
export NNN_USE_EDITOR=1
export NNN_BMS="h:~;d:~/Downloads;c:~/.config;f:~/granular/fabric3"
export NNN_OPENER="nnn_opener.sh"
export HOMEBREW_BUNDLE_FILE="$DOTFILES/homebrew/Brewfile"
export RIPGREP_CONFIG_PATH="$DOTFILES/config/ripgrep_config"
export FZF_DEFAULT_OPTS="--preview '
  if [ -d {} ]; then
    lsd --tree --color=always {} | head -100
  else
    bat --style=numbers --color=always --line-range=:500 {}
  fi
' --preview-window=right:45% \
  --bind 'ctrl-e:execute(hx {})' \
  --bind 'ctrl-v:execute-silent(bat {})' \
  --bind 'ctrl-c:execute-silent(cp -iv {} .)' \
  --bind 'ctrl-d:execute-silent(rm -i {})' \
  --header 'C-e: hx | C-v: bat | C-c: copy here | C-d: delete'"

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
[[ -r ~/.localrc ]] && source ~/.localrc
_zp localrc

# All topic files live exactly one level deep (e.g. git/aliases.zsh); a
# recursive ** glob walks all of bin/ and costs ~20ms.
typeset -U config_files
config_files=($DOTFILES/*/*.zsh)
_zp find-topic-files

# load the path files
for file in ${(M)config_files:#*/path.zsh}; do
  source $file
  _zp ${file#$DOTFILES/}
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}; do
  source $file
  _zp ${file#$DOTFILES/}
done

# Initialize completion. The full security audit (compaudit) only runs when
# the dump is over a day old; otherwise -C trusts the cached ~/.zcompdump.
autoload -Uz compinit
() {
  setopt local_options extended_glob
  if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) || ! -s ${ZDOTDIR:-$HOME}/.zcompdump ]]; then
    compinit
  else
    compinit -C
  fi
}
_zp compinit

# load every completion after compinit
for file in ${(M)config_files:#*/completion.zsh}; do
  source $file
  _zp ${file#$DOTFILES/}
done

unset config_files file

_cached_eval fzf fzf --zsh

# Better history
# Credits to https://coderwall.com/p/jpj_6q/zsh-better-history-searching-with-arrow-keys
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search # Up
bindkey "^[[B" down-line-or-beginning-search # Down
_zp history-keys

# ------------- zsh-helix-mode -------------
# Helix-style modal editing on the command line.
#
# Sourced LAST of anything touching ZLE so its keymaps win. Load order matters:
#   - `atuin init` (above) binds ^[[A -> atuin-up-search and ^R -> atuin-search
#   - the two bindkey lines above then re-bind ^[[A/^[[B for themselves
#   - zsh-helix-mode installs its own keymaps and supersedes both
# So expect up-arrow and ^R to behave the helix way, not the atuin way. To get
# atuin's search back, comment this block out rather than reordering it.
#
# NOTE: lives in ~/developer (a manual git clone), not in this repo, so it is
# guarded — a missing clone must not break shell startup.
ZHM_PLUGIN="$DOTFILES/zsh/zsh-helix-mode/zsh-helix-mode.plugin.zsh"
if [[ -r "$ZHM_PLUGIN" ]]; then
  source "$ZHM_PLUGIN"
else
  print -u2 "zshrc: zsh-helix-mode not found at $ZHM_PLUGIN (skipping)"
fi
unset ZHM_PLUGIN
_zp zsh-helix-mode

# ------------- yazi ----------
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# worktree-bin is a `go install` under mise; reached through its shim.
_cached_eval worktree worktree-bin shell-init

# Always open VSCode with mise paths
# ----------------------------------
code() {
    local arg workdir=""
    for arg in "$@"; do
        if [[ "$arg" != -* ]]; then
            workdir="$arg"
            break
        fi
    done

    if [[ -n "$workdir" ]]; then
        mise exec --cd "$workdir" -- code "$@"
    else
        command code "$@"
    fi
}

# >>> Bedrock integration >>>
export CLAUDE_CODE_USE_BEDROCK=1
export AWS_REGION=us-east-1
# Credentials come from granted's credential_process for this profile; log in
# with `aws-bedrock-login --login` instead of `assume` so no shell holds stale keys.
export AWS_PROFILE=corteva-workload-dev/AIDeveloperRole
export ANTHROPIC_DEFAULT_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
export ANTHROPIC_DEFAULT_SONNET_MODEL=us.anthropic.claude-sonnet-4-6
export ANTHROPIC_DEFAULT_OPUS_MODEL=us.anthropic.claude-opus-4-6-v1
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.services.pioneer.com:4317
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_METRIC_EXPORT_INTERVAL=10000
export OTEL_RESOURCE_ATTRIBUTES="user_name=timothy.bendt"
# <<< Bedrock integration <<<

if [[ -n $ZSH_PROFILE ]]; then
  _zp rest
  print -u2 "\n--- zprof (top functions) ---"
  zprof | head -25 >&2
fi
